# Copy this file to .env and change what you need. Every line is optional.

# Port on this machine where RaveBSD is reachable. Change it if 8080 is already used by something else.
PORT=8080

# Where the books live on this machine. Defaults are folders next to this file.
BOOKS_PATH=
AUDIOBOOKS_PATH=
# qBittorrent's downloads folder (mount the same folder into qBittorrent).
DOWNLOADS_PATH=

# Must match `id -u` and `id -g` of the user who owns the ./data, books and audiobooks folders.
PUID=1000
PGID=1000

# "browser" (default) sends a normal browser User-Agent, "rave" sends an honest RaveBSD one.
# Many sources refuse the honest one. Set here, it wins over the admin panel (System > Advanced); left empty,
# the admin panel decides.
USER_AGENT_MODE=

# An extra API key for /api/v1/search (X-API-Key header). Keys can also be made in the admin panel under Access.
API_KEY=

# Z-Library and Mobilism logins. Both can also be set in the admin panel under Libraries.
# Z-Library works without a login. Mobilism needs a (free) account.
ZLIB_EMAIL=
ZLIB_PASSWORD=
ZLIB_DOMAIN=
MOBILISM_USER=
MOBILISM_PASS=

# 1 = fixed to public mode: open to the internet, visitors search and keep their own downloads for a while, and
# everything else is behind the admin sign-in (no API keys). Without it, pick the mode at setup or in Settings.
PUBLIC_INSTANCE=

# Private mode without a password only answers to IP addresses, localhost and local names (.local, .lan, .ts.net
# and similar), so other websites cannot reach it through DNS tricks. List any other names you use, comma separated.
ALLOWED_HOSTS=
# 1 behind a reverse proxy: read the client's address from X-Forwarded-For (sign-in limits, visitor limits).
TRUST_PROXY=

# Pagehouse store backend (SQLite and private files default under DATA_DIR).
PAGEHOUSE_DB_PATH=
PAGEHOUSE_FILES_DIR=
# Optional callback URL must be HTTPS outside localhost. If unset, Paystack returns to its default flow.
PAGEHOUSE_CALLBACK_URL=
# Paystack secret key is server-only. Use a test key in development; never expose it to browser code.
PAYSTACK_SECRET_KEY=
# Optional API endpoint override. Only localhost/127.0.0.1 is accepted (for example, the local simulator).
PAYSTACK_API_BASE=
# Local Paystack simulator: set PAYSTACK_SECRET_KEY to the same test value on both services, then run
# `npm run paystack:sim`. The simulator listens only on 127.0.0.1.
PAYSTACK_SIM_PORT=8788
PAYSTACK_SIM_PUBLIC_URL=
PAYSTACK_SIM_WEBHOOK_URL=
# Webhook signing secret (whsec_…) from the Paystack dashboard. With it, webhooks must carry the timestamped
# Paystack-Signature header (replays older than 5 minutes are refused); without it the legacy header is checked.
PAYSTACK_WEBHOOK_SECRET=
# Optional key for signing Library cookies. If unset, a random private key is created under DATA_DIR.
PAGEHOUSE_LIBRARY_SECRET=
# Optional download-token signing key. If unset, a random private key is created under DATA_DIR.
PAGEHOUSE_TOKEN_SECRET=

# Store email over plain SMTP (any provider or your own mail server). Emails are kept in an outbox in the store
# database and sent with retries, so nothing is lost while these are unset: they wait until they are set.
#
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=starttls, SMTP_USER=your full Gmail address, and
# SMTP_PASS=an App Password (Google Account → Security → 2-Step Verification → App passwords; your normal password
# is refused). Leave PAGEHOUSE_EMAIL_FROM empty or use the same address: Gmail sends as the signed-in account.
# Personal Gmail allows about 500 emails a day, so set PAGEHOUSE_EMAIL_DAILY_LIMIT=450.
SMTP_HOST=
# 587 with STARTTLS is the usual submission port. Use SMTP_SECURE=tls for port 465. "none" only works for a mail
# server on this machine (a local relay, or a catcher like Mailpit for testing); sign-in is never sent unencrypted.
SMTP_PORT=
SMTP_SECURE=starttls
# Server-only. Leave both empty if the server needs no sign-in.
SMTP_USER=
SMTP_PASS=
# "Pagehouse <books@your-domain>" or just the address. Empty = "Pagehouse <SMTP_USER>".
PAGEHOUSE_EMAIL_FROM=
# Gets an email for every new book request. Leave empty for none.
PAGEHOUSE_OWNER_EMAIL=
# The storefront's public address (https://...), used for links and download links in emails.
PAGEHOUSE_PUBLIC_URL=
# Emails sent per UTC day before the rest wait for tomorrow (default 300). Set it to your provider's limit.
PAGEHOUSE_EMAIL_DAILY_LIMIT=

# Supabase PostgreSQL & Storage (for Render + Vercel cloud deployment).
# Run supabase/schema.sql in your Supabase SQL Editor first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=pagehouse-books
# Optional comma-separated list of Vercel frontend origins allowed to call the Render backend directly.
FRONTEND_ORIGIN=
